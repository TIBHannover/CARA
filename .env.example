# Copy to .env and fill in (KEY=value, no quotes). .env is gitignored and never synced.

# docker compose: signs login tokens; any random string of 32+ characters (openssl rand -hex 32)
CARA_SECRET_KEY=
# The first superuser, created when the API starts on a database without users (quickstart.sh generates the
# password).
CARA_ADMIN_USERNAME=admin
CARA_ADMIN_PASSWORD=
# Postgres password for the compose database (default: cara)
POSTGRES_PASSWORD=
# Capacity (compose defaults): API processes, and database connections per process (pool + overflow).
# Keep CARA_WORKERS x (pool + overflow) below Postgres' max_connections (100).
CARA_WORKERS=4
CARA_DB_POOL_SIZE=10
CARA_DB_MAX_OVERFLOW=10
# How long a login lasts, in minutes (default 12 hours)
CARA_TOKEN_MINUTES=720
# Host name people use to open the web app (default localhost); on a shared server, its network name
CARA_PUBLIC_HOST=localhost

# Running the backend or the cara CLI outside compose
CARA_DATABASE_URL=postgresql+psycopg://cara:cara@localhost:5432/cara
CARA_IMAGE_ROOT=data

# Hugging Face: DINOv3 is gated, accept its licence on the model page first.
HF_TOKEN=
HF_HOME=
