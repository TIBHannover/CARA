FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /usr/local/bin/uv
WORKDIR /app
ARG EXTRAS=""
COPY pyproject.toml ./
COPY src ./src
RUN uv pip install --system --no-cache ".${EXTRAS:+[$EXTRAS]}"
COPY alembic.ini ./
COPY migrations ./migrations
EXPOSE 8000
CMD ["sh", "-c", "alembic upgrade head && fastapi run --port 8000 --workers ${CARA_WORKERS:-1}"]
